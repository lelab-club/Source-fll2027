{{#contentFor "styles"}}
<link rel="stylesheet" href="{{asset 'css/fll/bootstrap.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/fontawesome-all.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/default.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/main.css'}}">
<style>
.td-organizers-wrap {
    padding: 100px 0;
}
.td-organizers-title {
    margin-bottom: 48px;
}
.td-organizer-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 12px;
    border-bottom: 1px solid #eee;
    cursor: pointer;
    transition: background 0.2s;
    border-radius: 8px;
}
.td-organizer-item:last-child {
    border-bottom: none;
}
.td-organizer-item.highlight {
    background: #f0f4ff;
}
.td-organizer-item-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    background: #f5f5f5;
}
.td-organizer-item-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.td-organizer-item-text {
    flex: 1;
    min-width: 0;
}
.td-organizer-item-title {
    font-weight: 600;
    font-size: 1.6rem;
    margin: 0;
    line-height: 1.3;
}
.td-organizer-item-subtitle {
    font-size: 1.3rem;
    color: #666;
    margin: 2px 0 0;
    line-height: 1.3;
}
.td-organizer-item-link {
    font-size: 1.3rem;
    color: #5033ff;
    text-decoration: none;
    display: inline-block;
    margin-top: 2px;
}
.td-organizer-item-link:hover {
    text-decoration: underline;
}
.td-organizer-pin {
    transition: all 0.2s;
    cursor: pointer;
}
.td-organizer-pin.highlight {
    fill: #5033ff;
}
.td-organizer-pin.highlight circle:first-child {
    r: 8;
    fill: #5033ff;
}
.td-organizer-pin.highlight circle:last-child {
    r: 12;
    fill: rgba(80, 51, 255, 0.15);
}
.td-map-svg-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}
.td-map-svg-wrap svg {
    width: 100%;
    max-width: 500px;
    height: auto;
}
@media (max-width: 991px) {
    .td-organizers-wrap .row {
        flex-direction: column-reverse;
    }
    .td-organizers-title {
        margin-bottom: 32px;
    }
}
</style>
{{/contentFor}}

{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}

<main class="gh-main">
    <article class="gh-article {{post_class}}">

        {{#match @page.show_title_and_feature_image}}
            <header class="gh-article-header gh-canvas">
                <h1 class="gh-article-title is-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
                {{/if}}
                {{> "feature-image"}}
            </header>
        {{/match}}

        <section class="gh-content gh-canvas is-body">
            {{content}}
        </section>

