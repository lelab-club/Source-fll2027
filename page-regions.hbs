{{#contentFor "styles"}}
<link rel="stylesheet" href="{{asset 'css/fll/bootstrap.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/fontawesome-all.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/default.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/main.css'}}">
<style>
    .td-organizers-wrap {
        padding: 100px 0;
    }

    .td-organizers-title {
        margin-bottom: 48px;
    }

    .td-organizer-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 12px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: background 0.2s;
        border-radius: 8px;
    }

    .td-organizer-item:last-child {
        border-bottom: none;
    }

    .td-organizer-item.highlight {
        background: #f0f4ff;
    }

    .td-organizer-item-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        overflow: hidden;
        background: #f5f5f5;
    }

    .td-organizer-item-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .td-organizer-item-text {
        flex: 1;
        min-width: 0;
    }

    .td-organizer-item-title {
        font-weight: 600;
        font-size: 1.6rem;
        margin: 0;
        line-height: 1.3;
    }

    .td-organizer-item-subtitle {
        font-size: 1.3rem;
        color: #666;
        margin: 2px 0 0;
        line-height: 1.3;
    }

    .td-organizer-item-link {
        font-size: 1.3rem;
        color: #5033ff;
        text-decoration: none;
        display: inline-block;
        margin-top: 2px;
    }

    .td-organizer-item-link:hover {
        text-decoration: underline;
    }

    .td-organizer-pin {
        transition: all 0.2s;
        cursor: pointer;
    }

    .td-organizer-pin.highlight {
        fill: #5033ff;
    }

    .td-organizer-pin.highlight circle:first-child {
        r: 6;
        fill: #5033ff;
    }

    .td-organizer-pin.highlight circle:last-child {
        r: 12;
        fill: rgba(80, 51, 255, 0.15);
    }

    .td-map-svg-wrap {
        position: relative;
        max-width: 100%;
        margin: 0 auto;
        aspect-ratio: 313 / 300;
    }

    .td-map-svg-wrap svg {
        display: block;
    }

    @media (min-width: 992px) {
        .td-organizers-wrap .row>.td-map-col {
            flex: 0 0 70%;
            max-width: 70%;
        }

        .td-organizers-wrap .row>.td-list-col {
            flex: 0 0 30%;
            max-width: 30%;
        }
    }

    .td-organizers-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.2rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #888;
        margin: 24px 0 12px;
        padding: 0 4px;
    }

    .td-organizers-section-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #e0e0e0;
    }

    .td-organizers-section-title:first-child {
        margin-top: 0;
    }

    .td-organizer-item.national {
        border-left: 3px solid #2979ff;
        margin-bottom: 2px;
    }

    .td-organizer-pin-national circle:first-child {
        r: 6;
    }

    .td-organizer-pin-national.highlight circle:first-child {
        r: 6;
        fill: #2979ff;
    }

    .td-organizer-pin-national.highlight circle:last-child {
        r: 12;
        fill: rgba(41, 121, 255, 0.15);
    }

    .td-organizers-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
        color: #aaa;
        font-size: 1.4rem;
    }

    .td-organizers-loading .spinner {
        width: 36px;
        height: 36px;
        border: 3px solid #e0e0e0;
        border-top-color: #5033ff;
        border-radius: 50%;
        animation: td-spin 0.8s linear infinite;
        margin-bottom: 16px;
    }

    @keyframes td-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .td-organizers-dimming .td-organizer-item:not(.highlight) {
        opacity: 0.25;
    }

    .td-organizers-dimming .td-organizer-pin:not(.highlight) {
        opacity: 0.2;
    }

    @media (max-width: 991px) {
        .td-organizers-wrap .row {
            flex-direction: column-reverse;
        }

        .td-organizers-title {
            margin-bottom: 32px;
        }
    }
</style>
{{/contentFor}}

{{!< default}} {{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}
    {{#post}} <main class="gh-main">
    <article class="gh-article {{post_class}}">

        {{#match @page.show_title_and_feature_image}}
        <header class="gh-article-header gh-canvas">
            <h1 class="gh-article-title is-title">{{title}}</h1>
            {{#if custom_excerpt}}
            <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}
            {{> "feature-image"}}
        </header>
        {{/match}}


        <div class="evente-wrap">
            <div class="td-organizers-wrap">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 td-map-col">
                            <div class="td-map-svg-wrap wow fadeInLeft" data-wow-duration="1.5s" data-wow-delay="0.4s">
                                <img src="{{asset 'images/france.svg'}}" alt="Carte de France"
                                    style="width: 100%; height: auto; display: block; pointer-events: none;">
                                <svg viewBox="0 0 313 300"
                                    style="position: absolute; inset: 0; width: 100%; height: 100%;"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <g id="organizers-lines"></g>
                                    <g id="organizers-pins"></g>
                                    <g class="td-organizer-pin">
                                        <image href="https://static.thenounproject.com/png/futuroscope-icon-42205-512.png" x="108" y="130" width="24" height="24"></image> 
                                    </g>
                                </svg>
                            </div>
                        </div>
                        <div class="col-lg-6 td-list-col">
                            <div class="td-organizers-list wow fadeInRight" data-wow-duration="1.5s"
                                data-wow-delay="0.6s">
                                <div id="organizers-list-content" style="display:none;">
                                    <div class="td-organizers-list-items"></div>
                                </div>
                                <div class="td-organizers-loading" id="organizers-loading">
                                    <div class="spinner"></div>
                                    <span>Chargement des organisateurs…</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="gh-content gh-canvas is-body">
            {{content}}
        </section>


    </article>
    </main>

    {{/post}}

    {{#contentFor "scripts"}}
    <script src="{{asset 'js/vendor/jquery.js'}}"></script>
    <script src="{{asset 'js/wow.min.js'}}"></script>
    <script>
        (function ($) {
            var futurX = 120, futurY = 142;

            function parseCSV(text) {
                var lines = text.trim().split('\n');
                var headers = lines[0].split(',');
                var rows = [];
                for (var i = 1; i < lines.length; i++) {
                    // Handle quoted fields
                    var line = lines[i];
                    var fields = [];
                    var current = '', inQuote = false;
                    for (var c = 0; c < line.length; c++) {
                        var ch = line[c];
                        if (ch === '"') {
                            inQuote = !inQuote;
                        } else if (ch === ',' && !inQuote) {
                            fields.push(current);
                            current = '';
                        } else {
                            current += ch;
                        }
                    }
                    fields.push(current);
                    var row = {};
                    for (var h = 0; h < headers.length; h++) {
                        row[headers[h].trim()] = fields[h] ? fields[h].trim() : '';
                    }
                    rows.push(row);
                }
                return rows;
            }

            function renderItem(row) {
                var typeClass = row.type === 'national' ? ' national' : '';
                var link = row.website
                    ? '<a class="td-organizer-item-link" href="' + $('<span>').text(row.website).html() + '" target="_blank">Site Internet</a>'
                    : '';
                return '<div class="td-organizer-item' + typeClass + '" data-organizer="' + row.id + '">'
                    + '<div class="td-organizer-item-icon">'
                    + '<img src="' + row.image + '" alt="">'
                    + '</div>'
                    + '<div class="td-organizer-item-text">'
                    + '<h4 class="td-organizer-item-title">' + row.name + '</h4>'
                    + '<p class="td-organizer-item-subtitle">' + row.location + '</p>'
                    + link
                    + '</div>'
                    + '</div>';
            }

            function renderPin(row) {
                if (!row.cx) return '';
                var cx = +row.cx, cy = +row.cy;
                var typeClass = row.type === 'national' ? ' td-organizer-pin-national' : '';
                return '<g class="td-organizer-pin' + typeClass + '" data-organizer="' + row.id + '" style="cursor: pointer;">'
                    + '<circle cx="' + cx + '" cy="' + cy + '" r="6" fill="' + (row.type === 'national' ? '#2979ff' : '#e74c3c') + '" stroke="#fff" stroke-width="2" />'
                    + '<circle cx="' + cx + '" cy="' + cy + '" r="12" fill="transparent" />'
                    + '</g>';
            }

            function renderLine(row) {
                if (!row.cx) return '';
                var cx = +row.cx, cy = +row.cy;
                var mx = (cx + futurX) / 2, my = (cy + futurY) / 2 - 12;
                return '<path d="M' + cx + ',' + cy + ' Q' + mx + ',' + my + ' ' + futurX + ',' + futurY + '" fill="none" stroke="#00000055" stroke-width="1" stroke-dasharray="5,4" />';
            }

            function bindHighlights() {
                var $wrap = $('.td-organizers-wrap');
                $(document).on('mouseenter', '.td-organizer-item, .td-organizer-pin', function () {
                    var id = $(this).data('organizer');
                    $('.td-organizer-pin[data-organizer="' + id + '"]').each(function () {
                        var parent = this.parentNode;
                        if (parent) parent.appendChild(this);
                    });
                    $('.td-organizer-item[data-organizer="' + id + '"]').addClass('highlight');
                    $('.td-organizer-pin[data-organizer="' + id + '"]').addClass('highlight');
                    $wrap.addClass('td-organizers-dimming');
                }).on('mouseleave', '.td-organizer-item, .td-organizer-pin', function () {
                    var id = $(this).data('organizer');
                    $('.td-organizer-item[data-organizer="' + id + '"]').removeClass('highlight');
                    $('.td-organizer-pin[data-organizer="' + id + '"]').removeClass('highlight');
                    $wrap.removeClass('td-organizers-dimming');
                });
            }

            $.get('{{asset "data/organizers.csv"}}', function (csv) {
                var rows = parseCSV(csv);

                var seen = {};
                var primaryRows = [];
                var pinRows = [];
                rows.forEach(function (row) {
                    if (row.name && !seen[row.id]) {
                        seen[row.id] = true;
                        primaryRows.push(row);
                    }
                    if (row.cx) {
                        pinRows.push(row);
                    }
                });

                var national = primaryRows.filter(function (row) { return row.type === 'national'; });
                var local = primaryRows.filter(function (row) { return row.type !== 'national'; })
                    .sort(function (a, b) { return (+a.cy || 9999) - (+b.cy || 9999); });

                // Dashed lines from national primary rows only
                var linesHtml = '';
                national.forEach(function (row) { linesHtml += renderLine(row); });
                $('#organizers-lines').html(linesHtml);

                // Pins from all coordinate rows (primary + extra)
                var pinsHtml = '';
                pinRows.forEach(function (row) { pinsHtml += renderPin(row); });
                $('#organizers-pins').html(pinsHtml);

                // List from primary rows only
                var listHtml = '<div class="td-organizers-section-title">Organisateurs du Festival 2027</div>';
                national.forEach(function (row) { listHtml += renderItem(row); });
                listHtml += '<div class="td-organizers-section-title">Organisateurs Locaux</div>';
                local.forEach(function (row) { listHtml += renderItem(row); });
                $('.td-organizers-list-items').html(listHtml);

                $('#organizers-list-content').show();
                $('#organizers-loading').hide();

                bindHighlights();
            });
        })(jQuery);
    </script>
    {{/contentFor}}