{{#contentFor "styles"}}
<link rel="stylesheet" href="{{asset 'css/fll/bootstrap.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/fontawesome-all.min.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/default.css'}}">
<link rel="stylesheet" href="{{asset 'css/fll/main.css'}}">
<style>
    .td-organizers-wrap {
        padding: 100px 0;
    }

    .td-organizers-title {
        margin-bottom: 48px;
    }

    .td-organizer-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 12px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        transition: background 0.2s;
        border-radius: 8px;
    }

    .td-organizer-item:last-child {
        border-bottom: none;
    }

    .td-organizer-item.highlight {
        background: #f0f4ff;
    }

    .td-organizer-item-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        overflow: hidden;
        background: #f5f5f5;
    }

    .td-organizer-item-icon img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .td-organizer-item-text {
        flex: 1;
        min-width: 0;
    }

    .td-organizer-item-title {
        font-weight: 600;
        font-size: 1.6rem;
        margin: 0;
        line-height: 1.3;
    }

    .td-organizer-item-subtitle {
        font-size: 1.3rem;
        color: #666;
        margin: 2px 0 0;
        line-height: 1.3;
    }

    .td-organizer-item-link {
        font-size: 1.3rem;
        color: #5033ff;
        text-decoration: none;
        display: inline-block;
        margin-top: 2px;
    }

    .td-organizer-item-link:hover {
        text-decoration: underline;
    }

    .td-organizer-pin {
        transition: all 0.2s;
        cursor: pointer;
    }

    .td-organizer-pin.highlight {
        fill: #5033ff;
    }

    .td-organizer-pin.highlight circle:first-child {
        r: 8;
        fill: #5033ff;
    }

    .td-organizer-pin.highlight circle:last-child {
        r: 12;
        fill: rgba(80, 51, 255, 0.15);
    }

    .td-map-svg-wrap {
        position: relative;
        max-width: 100%;
        margin: 0 auto;
        aspect-ratio: 313 / 300;
    }

    .td-map-svg-wrap svg {
        display: block;
    }

    @media (min-width: 992px) {
        .td-organizers-wrap .row>.td-map-col {
            flex: 0 0 70%;
            max-width: 70%;
        }

        .td-organizers-wrap .row>.td-list-col {
            flex: 0 0 30%;
            max-width: 30%;
        }
    }

    @media (max-width: 991px) {
        .td-organizers-wrap .row {
            flex-direction: column-reverse;
        }

        .td-organizers-title {
            margin-bottom: 32px;
        }
    }
</style>
{{/contentFor}}

